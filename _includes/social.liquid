{% if site.data.socials.email %}
  <a href="mailto:{{ site.data.socials.email }}" title="email"><i class="fa-solid fa-envelope social-icon-sm"></i></a>
{% endif %}
{% if site.data.socials.linkedin_username %}
  <a href="https://www.linkedin.com/in/{{ site.data.socials.linkedin_username }}" title="LinkedIn" target="_blank" rel="external nofollow noopener"><i class="fa-brands fa-linkedin social-icon-sm"></i></a>
{% endif %}
{% if site.data.socials.github_username %}
  <a href="https://github.com/{{ site.data.socials.github_username }}" title="GitHub" target="_blank" rel="external nofollow noopener"><i class="fa-brands fa-github social-icon-sm"></i></a>
{% endif %}

<style>
  .social .contact-icons,
  .contact-icons {
    font-size: 1.25rem !important;
  }
  .social .contact-icons a,
  .contact-icons a {
    margin-right: 0.5rem !important;
    display: inline-block;
  }
  .social .contact-icons a i,
  .social .contact-icons a svg,
  .contact-icons a i,
  .contact-icons a svg,
  .social-icon-sm {
    font-size: 1.25rem !important;
    width: 1.25rem !important;
    height: 1.25rem !important;
    line-height: 1.25rem !important;
    vertical-align: middle;
  }
</style>
